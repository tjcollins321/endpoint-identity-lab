# Copy to fleet/.env (ignored by git) and fill in. Names only in this file.

# MySQL: two passwords, any length, generated locally.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# Fleet server private key: at least 32 bytes, generated once with `openssl rand -base64 32`.
# Encrypts MDM certificates and other secrets at rest; changing it after MDM is on breaks MDM.
FLEET_SERVER_PRIVATE_KEY=

# Fleet Premium trial key. Leave empty to run Fleet Free.
FLEET_LICENSE_KEY=

# Cloudflare Tunnel connector token, from the tunnel's install command in the Cloudflare One dashboard.
TUNNEL_TOKEN=

# Enroll secrets, substituted into the GitOps YAML by `fleetctl gitops` (never literals there).
# Generated locally with `openssl rand -base64 24`; the fleetd package embeds the fleet's secret.
FLEET_GLOBAL_ENROLL_SECRET=
FLEET_WORKSTATIONS_ENROLL_SECRET=

# Chrome Enterprise Core enrollment token, referenced by the Chrome profile as a Fleet custom
# variable. fleetctl gitops reads FLEET_SECRET_* names from the environment and uploads them to
# Fleet; the value never appears in the repository.
FLEET_SECRET_CHROME_ENROLLMENT_TOKEN=

# Google Workspace SAML metadata for single sign-on to the Fleet console, the XML downloaded from
# the custom SAML app, on one line and single-quoted (it contains double quotes); substituted
# into org_settings.sso_settings.metadata by fleetctl gitops. Not a secret, but it names the
# tenant, so it stays out of the repository like everything else here.
FLEET_SSO_METADATA=
