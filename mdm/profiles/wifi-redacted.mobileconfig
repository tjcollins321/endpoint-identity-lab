<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadIdentifier</key>
	<string>dev.tjcollins.lab.wifi</string>
	<key>PayloadUUID</key>
	<string>REDACTED</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
	<key>PayloadDisplayName</key>
	<string>Wi-Fi (office network)</string>
	<key>PayloadDescription</key>
	<string>Redacted copy of the Wi-Fi payload the Jamf Now Employee baseline delivers: WPA2/WPA3 Personal, auto-join. Kept here as documentation only; the live payload is configured in the Jamf Now console and the password appears in no export. Not delivered through Fleet: the lab's Fleet-managed Macs are virtual machines without Wi-Fi hardware, and macOS does not install a Wi-Fi payload on such a machine.</string>
	<key>PayloadOrganization</key>
	<string>TJ Collins Lab</string>
	<key>PayloadScope</key>
	<string>System</string>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadType</key>
			<string>com.apple.wifi.managed</string>
			<key>PayloadIdentifier</key>
			<string>dev.tjcollins.lab.wifi.network</string>
			<key>PayloadUUID</key>
			<string>REDACTED</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>PayloadDisplayName</key>
			<string>Wi-Fi</string>
			<key>SSID_STR</key>
			<string>&lt;office SSID&gt;</string>
			<key>AutoJoin</key>
			<true/>
			<key>HIDDEN_NETWORK</key>
			<false/>
			<key>EncryptionType</key>
			<string>WPA2</string>
			<key>Password</key>
			<string>&lt;redacted&gt;</string>
		</dict>
	</array>
</dict>
</plist>
